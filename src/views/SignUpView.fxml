<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- The Root node is a StackPane to center the login box -->
<!-- Make sure fx:controller points to your actual package and class name -->

<StackPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #2b2b2b;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SignUpController">
    <children>
        <!-- The VBox acts as the white "Login Card" in the center -->
        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 0);">
            <padding>
                <Insets bottom="40.0" left="100.0" right="100.0" top="40.0" />
            </padding>
            <children>
                <!-- Title Label -->
                <Label text="MyCinema SignUp" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <Label text="Sign up to MyCinema below." textFill="#666666" />

                <!--first name input -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="First Name">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="firstNameField" prefHeight="35.0" promptText="Enter your first name" />
                    </children>
                </VBox>

                <!--last name input -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Last Name">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="lastNameField" prefHeight="35.0" promptText="Enter your last name" />
                    </children>
                </VBox>

                <!--username input -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Username">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="usernameField" prefHeight="35.0" promptText="Enter a username" />
                    </children>
                </VBox>

                <!--password input-->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Password">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="passwordField" prefHeight="35.0" promptText="Enter a password" />
                    </children>
                </VBox>

                <!--feedback labels for errors such as incorrect login-->
                <!--kept empty initially but will turn red via the controller-->
                <Label fx:id="feedbackLabel" textFill="#e74c3c" wrapText="true" />

                <!-- Login Button triggers handleSignup() in the controller -->
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSignUp" prefHeight="40.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Sign Up" />

                <!-- Hyperlink to swap to the Sign Up screen -->
                <Hyperlink onAction="#handleReturnLoginSwitch" text="Already have an account? Log In" textFill="#3498db" />
            </children>
        </VBox>
    </children>
</StackPane>
